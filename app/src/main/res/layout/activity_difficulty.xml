<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <com.samarthshukla.protyper.FloatingKeycapsView
        android:id="@+id/floatingKeycapsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="24dp">

                <!-- Header -->
                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font"
                    android:text="Practice Setup"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSetupSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Configure your next typing session."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Difficulty: Single Word only -->
                <LinearLayout
                    android:id="@+id/difficultySection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Difficulty"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Choose your challenge level."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Difficulty Selection -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/bg_main"
                        app:cardCornerRadius="60dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D8E1EB"
                        app:strokeWidth="1dp">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/difficultyGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@id/btnMedium">

                            <!-- Easy -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEasy"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                app:strokeColor="@color/setup_button_stroke"
                                app:strokeWidth="1dp"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="6dp"
                                android:text="Easy"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_difficulty_easy"
                                app:iconGravity="textTop"
                                app:iconSize="88dp"
                                app:iconPadding="4dp"
                                app:iconTint="@null" />

                            <!-- Medium -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMedium"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                app:strokeColor="@color/setup_button_stroke"
                                app:strokeWidth="1dp"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="6dp"
                                android:text="Medium"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_difficulty_medium"
                                app:iconGravity="textTop"
                                app:iconSize="88dp"
                                app:iconPadding="4dp"
                                app:iconTint="@null" />

                            <!-- Hard -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnHard"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                app:strokeColor="@color/setup_button_stroke"
                                app:strokeWidth="1dp"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="6dp"
                                android:text="Hard"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:icon="@drawable/ic_difficulty_hard"
                                app:iconGravity="textTop"
                                app:iconSize="88dp"
                                app:iconPadding="4dp"
                                app:iconTint="@null" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_timer2"
                            android:contentDescription="Timer"
                            android:layout_marginEnd="9dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Practice Duration"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Choose how long you want to practice."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- One unified duration selector with two rows -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/bg_main"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D8E1EB"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <!-- Short Durations -->
                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/durationGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:singleSelection="true"
                                app:selectionRequired="true"
                                app:checkedButton="@id/btnDuration60">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDuration15"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="15 sec"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDuration30"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="30 sec"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDuration60"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="60 sec"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />

                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <!-- Long Durations -->
                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/durationGroupLong"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                app:singleSelection="true"
                                app:selectionRequired="true"
                                app:checkedButton="@id/btnDuration300">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDuration120"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="120 sec"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDuration300"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="300 sec"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDurationUnlimited"
                                    app:strokeColor="@color/setup_button_stroke"
                                    app:strokeWidth="1dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:text="∞"
                                    android:textColor="@color/text_primary"
                                    android:textSize="11sp" />

                            </com.google.android.material.button.MaterialButtonToggleGroup>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Strict Mode -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="@color/bg_main"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D8E1EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:src="@drawable/ic_strict_mode"
                                    android:contentDescription="Strict Mode"
                                    android:layout_marginEnd="5dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Strict Mode"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </LinearLayout>


                            <TextView
                                android:id="@+id/tvStrictModeDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="OFF · You can correct mistakes."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>


                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchBackspace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:contentDescription="Toggle Strict Mode"
                            android:minWidth="56dp"
                            android:minHeight="48dp"
                            android:showText="false"
                            android:padding="4dp"
                            app:thumbTint="@color/strict_switch_thumb"
                            app:trackTint="@color/strict_switch_track" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <!-- Start Practice -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartPractice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="START PRACTICE"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pro_blue_primary"
            app:cornerRadius="18dp" />

        <!-- Banner Ad -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            ads:adSize="BANNER"
            ads:adUnitId="@string/Banner" />

    </LinearLayout>

</FrameLayout>